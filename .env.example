# Smart Deal Hunter — configuration (copier vers .env et compléter)
# NE JAMAIS COMMITER LE FICHIER .env

# --- CORS / sécurité d'accès ---
# Origine de l'extension installée : chrome-extension://<ID> (voir chrome://extensions)
# Exemple : SDH_CORS_ORIGINS=chrome-extension://abcdefghijklmnop
SDH_CORS_ORIGINS=
# Uniquement pour le développement local hors extension (sinon laisser vide)
SDH_CORS_ALLOW_ALL_DEV=false

# --- Limites et sécurité ---
SDH_MAX_QUERY_LENGTH=160
SDH_SEARCH_TIMEOUT_S=12
SDH_VERIFY_TOP_N=8
SDH_MAX_RESULTS_PER_SOURCE=10
SDH_MAX_RESPONSE_BYTES=512000
SDH_FETCH_TIMEOUT_S=10
SDH_RATE_LIMIT_REQUESTS=10
SDH_RATE_LIMIT_WINDOW_S=60

# --- Géolocalisation approximative (gratuit, non commercial : ip-api.com) ---
SDH_GEOIP_ENABLED=true
SDH_DEFAULT_COUNTRY=FR

# --- Devise (BCE via frankfurter.dev, gratuit) ---
SDH_FX_API_URL=https://api.frankfurter.dev/v1/latest

# --- Recherche approfondie (NIVEAU 2, PAYANT, désactivé par défaut) ---
# Aucun service payant n'est requis. Pour activer plus tard :
SDH_DEEP_SEARCH_ENABLED=false
SDH_DEEP_SEARCH_PROVIDER=
SDH_DEEP_SEARCH_API_KEY=
# Budget mensuel en EUR : 0 => AUCUN appel payant, jamais.
SDH_MONTHLY_BUDGET_EUR=0
